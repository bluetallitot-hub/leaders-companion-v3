{
  "schema": "leaders-companion-instruction-library",
  "version": 2,
  "description": "Reusable prayer-level spoken instruction templates. Source cue CSV and original siddur remain unchanged.",
  "placeholderSyntax": "{MetadataField}",
  "allowedPlaceholders": [
    "PrayerName",
    "PageNumber",
    "PageName",
    "ServiceName",
    "SectionName"
  ],
  "prayers": [
    {
      "prayer_id": "amidah",
      "canonical_title": "Amidah",
      "aliases": [
        "The Amidah",
        "עמידה"
      ],
      "instructions": [
        {
          "instruction_id": 1001,
          "kind": "spoken",
          "text": "Please rise for the {PrayerName} on page {PageNumber}.",
          "required": [
            "PrayerName",
            "PageNumber"
          ],
          "enabled": true,
          "approval_status": "proposed",
          "notes": "Example supplied by user; approve wording before production."
        }
      ]
    },
    {
      "prayer_id": "lecha-dodi",
      "canonical_title": "Lecha Dodi",
      "aliases": [
        "Leha Dodi",
        "Lekha Dodi",
        "L'cha Dodi",
        "לכה דודי"
      ],
      "instructions": []
    }
  ],
  "matching": {
    "priority": [
      "prayer_id",
      "canonical_title",
      "aliases"
    ],
    "caseInsensitive": true,
    "automaticInsertion": "only when instruction approved and page mapping verified",
    "unmatched": "review_required",
    "ambiguous": "review_required"
  },
  "provenance": {
    "created_for": "Leader's Companion V3",
    "source": "User example: Amidah instruction"
  }
}
